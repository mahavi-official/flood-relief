{
  "name": "flood-relief",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nepal flood relief: report missing persons, found persons, and send an SOS for food, shelter or medicine.",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:client && npm run build:server && npm run prerender",
    "build:client": "vite build --outDir dist",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.js",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/make-og-image.js"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
